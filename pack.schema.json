{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/AymanShams/codex-coding-os/blob/main/pack.schema.json",
  "title": "Codex Coding OS Pack Manifest",
  "$defs": {
    "artifactTrigger": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["trigger_id", "kind", "phase"],
          "properties": {
            "trigger_id": {
              "type": "string",
              "minLength": 1
            },
            "kind": {
              "const": "workflow_phase"
            },
            "phase": {
              "type": "string",
              "enum": [
                "0_route_scope",
                "1_source_inventory",
                "2_material_decisions",
                "3_controlled_docs",
                "4_tdd_alignment",
                "5_repo_documentation",
                "6_agent_instructions",
                "7_handoff",
                "8_final_validation"
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["trigger_id", "kind"],
          "properties": {
            "trigger_id": {
              "type": "string",
              "minLength": 1
            },
            "kind": {
              "const": "manual"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["trigger_id", "kind", "match", "predicates"],
          "properties": {
            "trigger_id": {
              "type": "string",
              "minLength": 1
            },
            "kind": {
              "const": "conditional"
            },
            "match": {
              "type": "string",
              "enum": ["any", "all"]
            },
            "predicates": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["fact", "operator", "value"],
                "properties": {
                  "fact": {
                    "type": "string",
                    "minLength": 1
                  },
                  "operator": {
                    "const": "equals"
                  },
                  "value": {
                    "type": "boolean"
                  }
                }
              }
            }
          }
        }
      ]
    }
  },
  "type": "object",
  "additionalProperties": true,
  "required": [
    "version",
    "package_name",
    "display_name",
    "release_status",
    "source_of_truth",
    "artifact_contract_version",
    "artifact_definitions",
    "required_files",
    "support_items",
    "bundled_skills",
    "release_safety",
    "installation"
  ],
  "properties": {
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+([\\-+][0-9A-Za-z.-]+)?$"
    },
    "package_name": {
      "type": "string",
      "const": "codex-coding-os"
    },
    "display_name": {
      "type": "string"
    },
    "release_status": {
      "type": "string"
    },
    "source_of_truth": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "artifact_contract_version": {
      "type": "string",
      "const": "1.1"
    },
    "artifact_definitions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "artifact_id",
          "family_id",
          "artifact_type",
          "path",
          "source_status",
          "relationship",
          "owner",
          "consumers",
          "trigger",
          "generation_route"
        ],
        "properties": {
          "artifact_id": {
            "type": "string",
            "minLength": 1
          },
          "family_id": {
            "type": "string",
            "minLength": 1
          },
          "artifact_type": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?![A-Za-z]:)(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\]+$"
          },
          "source_status": {
            "type": "string",
            "enum": [
              "authoritative",
              "projection"
            ]
          },
          "relationship": {
            "type": "string",
            "enum": [
              "canonical",
              "exact_mirror",
              "intentional_variant",
              "derived"
            ]
          },
          "owner": {
            "type": "string",
            "minLength": 1
          },
          "consumers": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "trigger": {
            "$ref": "#/$defs/artifactTrigger"
          },
          "generation_route": {
            "type": "string",
            "minLength": 1
          },
          "canonical_artifact_id": {
            "type": "string",
            "minLength": 1
          },
          "variant_reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "required_files": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "support_items": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "bundled_skills": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["name", "category", "required", "source"],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "category": {
            "type": "string",
            "minLength": 1
          },
          "required": {
            "type": "boolean"
          },
          "source": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "release_safety": {
      "type": "object",
      "additionalProperties": true,
      "required": ["forbidden_file_extensions", "excluded_paths"],
      "properties": {
        "forbidden_file_extensions": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^\\."
          },
          "uniqueItems": true
        },
        "excluded_paths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      }
    },
    "installation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "transaction_protocol",
        "bundle_protocol",
        "bundle_manifest",
        "managed_skill_root",
        "runtime_files",
        "universal_policy_sources",
        "capability_refresh_cli",
        "external_skills_staged"
      ],
      "properties": {
        "transaction_protocol": { "type": "string", "const": "ccos-install-transaction-v1" },
        "bundle_protocol": { "type": "string", "const": "CCOS-INSTALL-BUNDLE-v1" },
        "bundle_manifest": { "type": "string", "const": "install-bundle.manifest.json" },
        "managed_skill_root": { "type": "string", "const": ".agents/skills" },
        "runtime_files": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "universal_policy_sources": {
          "type": "object",
          "additionalProperties": false,
          "required": ["global_agents", "default_rules"],
          "properties": {
            "global_agents": { "type": "string", "minLength": 1 },
            "default_rules": { "type": "string", "minLength": 1 }
          }
        },
        "capability_refresh_cli": { "type": "string", "minLength": 1 },
        "external_skills_staged": { "type": "boolean", "const": false }
      }
    }
  }
}
