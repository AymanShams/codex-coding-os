{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/codex-coding-os/routing-policy.schema.json",
  "title": "Universal Capability Routing Policy",
  "type": "object",
  "required": [
    "schema_version",
    "decision_snapshot",
    "max_supports",
    "max_worker_supports",
    "capability_aliases",
    "default_execution_profile",
    "execution_profiles",
    "live_dependency_controls",
    "local_execution_rules",
    "worker_rules",
    "rules"
  ],
  "properties": {
    "schema_version": { "type": "string", "minLength": 1 },
    "decision_snapshot": { "type": "string", "minLength": 1 },
    "max_supports": { "type": "integer", "minimum": 0, "maximum": 2 },
    "max_worker_supports": { "type": "integer", "minimum": 0, "maximum": 2 },
    "capability_aliases": {
      "type": "object",
      "propertyNames": { "type": "string", "minLength": 1 },
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": { "type": "string", "minLength": 1 }
      }
    },
    "default_execution_profile": { "type": "string", "minLength": 1 },
    "execution_profiles": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "$ref": "#/$defs/execution_profile" }
    },
    "live_dependency_controls": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/live_dependency_control" }
    },
    "local_execution_rules": {
      "type": "array",
      "items": { "$ref": "#/$defs/local_execution_rule" }
    },
    "worker_rules": {
      "type": "array",
      "items": { "$ref": "#/$defs/worker_rule" }
    },
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "scenario",
          "match_any",
          "match_all",
          "primary",
          "supports",
          "requires",
          "forbids",
          "authority_limit",
          "evidence_ids"
        ],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "scenario": { "type": "string", "minLength": 1 },
          "match_any": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 },
            "uniqueItems": true
          },
          "match_all": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 },
            "uniqueItems": true
          },
          "primary": { "type": "string", "minLength": 1 },
          "supports": {
            "type": "array",
            "maxItems": 2,
            "items": { "type": "string", "minLength": 1 },
            "uniqueItems": true
          },
          "requires": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 },
            "uniqueItems": true
          },
          "forbids": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 },
            "uniqueItems": true
          },
          "authority_limit": { "type": "string", "minLength": 1 },
          "evidence_ids": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 },
            "uniqueItems": true
          },
          "execution_profile": { "type": "string", "minLength": 1 },
          "intent_gate": {
            "type": "string",
            "enum": [
              "documentation_combined",
              "documentation_only",
              "not_documentation_only",
              "implementation",
              "no_implementation",
              "architecture_review",
              "capability_invocation",
              "github_ci_context",
              "github_review_context",
              "coding_validation_context",
              "coding_branch_context",
              "coding_feedback_context",
              "software_documentation_only",
              "software_project_lifecycle",
              "deep_critique",
              "source_evaluation",
              "operational_problem_analysis",
              "operational_problem_review",
              "metric_diagnostics",
              "data_quality_analysis",
              "spreadsheet_analysis",
              "pdf_analysis",
              "critical_pdf_review",
              "strategic_option_decision",
              "pricing_strategy",
              "operating_model_design",
              "situation_assessment",
              "critique_with_implementation",
              "deliverable_execution",
              "security_diff_review",
              "security_standard_scan",
              "security_deep_scan",
              "security_finding_triage",
              "security_finding_validation",
              "security_attack_path_analysis",
              "security_finding_discovery",
              "security_finding_fix",
              "security_policy_definition",
              "codex_security_threat_model",
              "local_security_threat_model",
              "security_hardening_proposal",
              "security_vulnerability_writeup",
              "security_findings_tracking",
              "security_ownership_mapping",
              "defensive_security_checklist",
              "security_best_practices_review",
              "security_implementation",
              "provider_security_implementation",
              "provider_implementation",
              "postgres_security_implementation",
              "postgres_implementation",
              "frontend_security_implementation",
              "provider_operations",
              "neon_egress"
            ]
          },
          "reason_codes": {
            "type": "array",
            "items": { "$ref": "#/$defs/reason_code" },
            "uniqueItems": true
          },
          "requires_live_dependencies": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 },
            "uniqueItems": true
          },
          "dependency_fallback": { "$ref": "#/$defs/dependency_fallback" }
        },
        "additionalProperties": false
      }
    },
    "explicit_overrides": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "target", "action", "reason"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "target": { "type": "string", "minLength": 1 },
          "action": {
            "type": "string",
            "enum": ["suppress", "tactical-only"]
          },
          "requires_primary": { "type": "string" },
          "winner": { "type": "string" },
          "reason": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "reason_code": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]{1,63}$"
    },
    "live_dependency_control": {
      "type": "object",
      "required": ["manifest_any", "config_path", "expected_value", "probe_requirement"],
      "properties": {
        "manifest_any": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "config_path": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "expected_value": { "type": ["boolean", "string", "number"] },
        "probe_requirement": {
          "type": "object",
          "required": ["kind", "target", "success_status"],
          "properties": {
            "kind": { "const": "live_call" },
            "target": { "type": "string", "minLength": 1 },
            "success_status": { "const": "callable" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "dependency_fallback": {
      "type": "object",
      "required": [
        "selected_capability",
        "supports",
        "chosen_fallback",
        "equivalence",
        "max_passes",
        "deadline_seconds",
        "reason_code"
      ],
      "properties": {
        "selected_capability": { "type": "string" },
        "equivalent_capabilities": {
          "type": "array",
          "maxItems": 8,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "supports": {
          "type": "array",
          "maxItems": 2,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "chosen_fallback": { "type": "string", "minLength": 1 },
        "equivalence": { "enum": ["equivalent", "non_equivalent"] },
        "max_passes": { "type": "integer", "minimum": 1, "maximum": 4 },
        "deadline_seconds": { "type": "integer", "minimum": 1, "maximum": 7200 },
        "reason_code": { "$ref": "#/$defs/reason_code" }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": { "equivalence": { "const": "equivalent" } },
            "required": ["equivalence"]
          },
          "then": {
            "properties": {
              "selected_capability": { "type": "string", "minLength": 1 }
            }
          }
        }
      ]
    },
    "fallback": {
      "type": "object",
      "required": ["on_unavailable", "on_timeout", "on_error", "automatic_retry"],
      "properties": {
        "on_unavailable": { "const": "return_to_codex" },
        "on_timeout": { "const": "return_to_codex" },
        "on_error": { "const": "return_to_codex" },
        "automatic_retry": { "const": false }
      },
      "additionalProperties": false
    },
    "execution_profile": {
      "type": "object",
      "required": [
        "execution_owner",
        "model",
        "reasoning_effort",
        "deadline_seconds",
        "fallback"
      ],
      "properties": {
        "execution_owner": {
          "enum": ["codex_parent", "codex_child", "local_agent_stack", "antigravity"]
        },
        "model": { "type": "string", "minLength": 1 },
        "reasoning_effort": {
          "type": ["string", "null"],
          "enum": ["low", "medium", "high", "xhigh", "max", "ultra", null]
        },
        "deadline_seconds": { "type": "integer", "minimum": 1, "maximum": 7200 },
        "fallback": { "$ref": "#/$defs/fallback" }
      },
      "additionalProperties": false
    },
    "worker": {
      "type": "object",
      "required": [
        "execution_owner",
        "role",
        "model",
        "reasoning_effort",
        "deadline_seconds",
        "required"
      ],
      "properties": {
        "execution_owner": {
          "enum": ["codex_child", "local_agent_stack"]
        },
        "role": { "type": "string", "minLength": 1 },
        "model": { "type": "string", "minLength": 1 },
        "reasoning_effort": {
          "type": ["string", "null"],
          "enum": ["low", "medium", "high", "xhigh", "max", "ultra", null]
        },
        "deadline_seconds": { "type": "integer", "minimum": 1, "maximum": 3600 },
        "required": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "worker_rule": {
      "type": "object",
      "required": [
        "id",
        "priority",
        "match_any",
        "match_all",
        "classification_any",
        "classification_all",
        "requires_any_capabilities",
        "worker",
        "reason_code"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "priority": { "type": "integer", "minimum": 1, "maximum": 1000 },
        "match_any": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "match_all": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "classification_any": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "classification_all": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "exclusive": { "type": "boolean" },
        "gateway_managed_upstream": { "type": "string", "minLength": 1 },
        "requires_any_capabilities": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "worker": { "$ref": "#/$defs/worker" },
        "reason_code": { "$ref": "#/$defs/reason_code" }
      },
      "additionalProperties": false
    },
    "local_execution_rule": {
      "type": "object",
      "required": [
        "id",
        "priority",
        "match_any",
        "match_all",
        "classification_any",
        "classification_all",
        "gateway_managed_upstream",
        "requires_any_capabilities",
        "recipe_id",
        "local_stack_purpose",
        "task_type",
        "source_need",
        "exact_evidence",
        "reason_code"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "priority": { "type": "integer", "minimum": 1, "maximum": 1000 },
        "match_any": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "match_all": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "classification_any": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "classification_all": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "gateway_managed_upstream": { "const": "local-agent-stack" },
        "requires_any_capabilities": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "recipe_id": {
          "enum": ["runtime_status", "memory_recall", "source_lookup", "literal_extraction"]
        },
        "local_stack_purpose": {
          "enum": ["runtime_status", "prior_continuity", "project_evidence_lookup", "literal_structured_extraction"]
        },
        "task_type": { "enum": ["status", "answer", "recall", "research", "review", "extract"] },
        "source_need": { "enum": ["none", "memory", "index", "both"] },
        "exact_evidence": { "type": "boolean" },
        "reason_code": { "$ref": "#/$defs/reason_code" }
      },
      "additionalProperties": false
    }
  }
}
