{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.codex/capability-authority-receipt-v2.schema.json",
  "title": "Capability Authority Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "config_projection_sha256",
    "config_leaf_hashes",
    "plugin_cache_inventory_sha256",
    "plugin_cache_row_hashes",
    "plugin_capability_surfaces",
    "plugin_package_manifests",
    "plugin_package_origins",
    "required_source_hashes",
    "app_identity",
    "snapshot_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": "capability-authority-receipt-v2"
    },
    "config_projection_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "config_leaf_hashes": {
      "$ref": "#/$defs/hashMap"
    },
    "plugin_cache_inventory_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "plugin_cache_row_hashes": {
      "$ref": "#/$defs/hashMap"
    },
    "plugin_capability_surfaces": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "kind"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "kind": {
              "enum": [
                "plugin",
                "skill",
                "tool-family",
                "mcp"
              ]
            }
          }
        }
      }
    },
    "plugin_package_manifests": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "version",
          "manifest_sha256"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "manifest_sha256": {
            "$ref": "#/$defs/sha256"
          }
        }
      }
    },
    "plugin_package_origins": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "remote_plugin_id",
          "install_receipt_sha256"
        ],
        "properties": {
          "remote_plugin_id": {
            "type": "string",
            "pattern": "^[-A-Za-z0-9._:~]{8,256}$"
          },
          "install_receipt_sha256": {
            "$ref": "#/$defs/sha256"
          }
        }
      }
    },
    "required_source_hashes": {
      "$ref": "#/$defs/requiredSourceHashMap"
    },
    "app_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "app_version",
        "runtime_id",
        "cli_id",
        "trusted_browser_client_sha256",
        "browser_client_sha256",
        "runtime_executable_sha256",
        "cli_executable_sha256",
        "coherent"
      ],
      "properties": {
        "app_version": {
          "type": "string",
          "minLength": 1
        },
        "runtime_id": {
          "type": "string",
          "minLength": 1
        },
        "cli_id": {
          "type": "string",
          "minLength": 1
        },
        "trusted_browser_client_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "browser_client_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "runtime_executable_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "cli_executable_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "coherent": {
          "const": true
        }
      }
    },
    "snapshot_sha256": {
      "$ref": "#/$defs/sha256"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[A-Fa-f0-9]{64}$"
    },
    "hashMap": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/sha256"
      }
    },
    "requiredSourceHashMap": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hooks.json",
        "AGENTS.md",
        "task-routing-gate.md",
        "catalogue-router.SKILL.md",
        "capability_index.py",
        "capability_config_fingerprint.py",
        "capability_index_cli.py",
        "user_prompt_skill_router.py",
        "capability_index_session_start.py",
        "_common.py",
        "_hook_io.py",
        "query-catalogue.ps1",
        "routing-policy.yaml",
        "routing-policy.schema.json",
        "active-capabilities.schema.json",
        "project-scope-map.json",
        "project-scope-map.schema.json",
        "route-decision.schema.json",
        "ensure-node-dependencies.ps1",
        "capability_manifest_recovery.py",
        "capability-manifest-builder.ps1",
        "authority-receipt.schema.json"
      ],
      "properties": {
        "hooks.json": { "$ref": "#/$defs/sha256" },
        "AGENTS.md": { "$ref": "#/$defs/sha256" },
        "task-routing-gate.md": { "$ref": "#/$defs/sha256" },
        "catalogue-router.SKILL.md": { "$ref": "#/$defs/sha256" },
        "capability_index.py": { "$ref": "#/$defs/sha256" },
        "capability_config_fingerprint.py": { "$ref": "#/$defs/sha256" },
        "capability_index_cli.py": { "$ref": "#/$defs/sha256" },
        "user_prompt_skill_router.py": { "$ref": "#/$defs/sha256" },
        "capability_index_session_start.py": { "$ref": "#/$defs/sha256" },
        "_common.py": { "$ref": "#/$defs/sha256" },
        "_hook_io.py": { "$ref": "#/$defs/sha256" },
        "query-catalogue.ps1": { "$ref": "#/$defs/sha256" },
        "routing-policy.yaml": { "$ref": "#/$defs/sha256" },
        "routing-policy.schema.json": { "$ref": "#/$defs/sha256" },
        "active-capabilities.schema.json": { "$ref": "#/$defs/sha256" },
        "project-scope-map.json": { "$ref": "#/$defs/sha256" },
        "project-scope-map.schema.json": { "$ref": "#/$defs/sha256" },
        "route-decision.schema.json": { "$ref": "#/$defs/sha256" },
        "ensure-node-dependencies.ps1": { "$ref": "#/$defs/sha256" },
        "capability_manifest_recovery.py": { "$ref": "#/$defs/sha256" },
        "capability-manifest-builder.ps1": { "$ref": "#/$defs/sha256" },
        "authority-receipt.schema.json": { "$ref": "#/$defs/sha256" }
      }
    }
  }
}
