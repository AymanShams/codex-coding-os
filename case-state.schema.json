{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/AymanShams/codex-coding-os/blob/main/case-state.schema.json",
  "title": "Codex Coding OS Automation Case-State Store",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "revision", "updated_at", "cases", "bindings", "store_events"],
  "properties": {
    "schema_version": { "const": 2 },
    "revision": { "type": "integer", "minimum": 0 },
    "updated_at": { "type": ["string", "null"] },
    "cases": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/case" }
    },
    "bindings": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/caseId" }
    },
    "store_events": { "type": "object" }
  },
  "$defs": {
    "caseId": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "requestId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": ".*\\S.*"
    },
    "sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "headMap": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/sha" }
    },
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract", "sha256", "head"],
      "properties": {
        "contract": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/digest" },
        "head": { "$ref": "#/$defs/sha" }
      }
    },
    "snapshotMap": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/snapshot" }
    },
    "legacyReviewSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract", "sha256"],
      "properties": {
        "contract": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/digest" }
      }
    },
    "reviewSnapshotMap": {
      "type": "object",
      "additionalProperties": {
        "oneOf": [
          { "$ref": "#/$defs/snapshot" },
          { "$ref": "#/$defs/legacyReviewSnapshot" }
        ]
      }
    },
    "branchBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "value"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "value": { "type": "string", "minLength": 1 }
      }
    },
    "caseBindings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repo_url", "branch", "worktree", "pr", "thread", "universal_bundle"],
      "properties": {
        "repo_url": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "branch": { "type": "array", "items": { "$ref": "#/$defs/branchBinding" }, "uniqueItems": true },
        "worktree": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "pr": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "thread": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "universal_bundle": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "review_heads",
        "review_snapshots",
        "current_heads",
        "repaired_heads",
        "repaired_snapshots",
        "observed_heads"
      ],
      "properties": {
        "review_heads": { "$ref": "#/$defs/headMap" },
        "review_snapshots": { "$ref": "#/$defs/reviewSnapshotMap" },
        "current_heads": { "$ref": "#/$defs/headMap" },
        "repaired_heads": { "$ref": "#/$defs/headMap" },
        "repaired_snapshots": { "$ref": "#/$defs/snapshotMap" },
        "observed_heads": { "$ref": "#/$defs/headMap" }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "implementation_generations",
        "review_cohorts",
        "combined_repairs",
        "closure_checks",
        "operational_retries"
      ],
      "properties": {
        "implementation_generations": { "type": "integer", "minimum": 0, "maximum": 1 },
        "review_cohorts": { "type": "integer", "minimum": 0, "maximum": 1 },
        "combined_repairs": { "type": "integer", "minimum": 0, "maximum": 1 },
        "closure_checks": { "type": "integer", "minimum": 0, "maximum": 1 },
        "operational_retries": { "type": "integer", "minimum": 0, "maximum": 1 }
      }
    },
    "nativeUuid7": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "reviewAssignmentV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reviewer_id", "reviewer_role", "thread_id", "repository",
        "reviewed_head", "snapshot", "scope", "scope_sha256", "required"
      ],
      "properties": {
        "reviewer_id": { "type": "string", "minLength": 1 },
        "reviewer_role": { "const": "review_child" },
        "thread_id": { "type": "string", "minLength": 1 },
        "repository": { "type": "string", "minLength": 1 },
        "reviewed_head": { "$ref": "#/$defs/sha" },
        "snapshot": {
          "oneOf": [
            { "$ref": "#/$defs/snapshot" },
            { "$ref": "#/$defs/legacyReviewSnapshot" }
          ]
        },
        "scope": { "type": "string", "minLength": 1 },
        "scope_sha256": { "$ref": "#/$defs/digest" },
        "required": { "const": true }
      }
    },
    "reviewAssignmentV2": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reviewer_id", "reviewer_role", "thread_id", "native_thread_id",
        "native_parent_thread_id", "agent_path", "repository", "reviewed_head",
        "snapshot", "scope", "scope_sha256", "required"
      ],
      "properties": {
        "reviewer_id": { "type": "string", "minLength": 1 },
        "reviewer_role": { "const": "review_child" },
        "thread_id": { "type": "string", "minLength": 1 },
        "native_thread_id": { "$ref": "#/$defs/nativeUuid7" },
        "native_parent_thread_id": { "$ref": "#/$defs/nativeUuid7" },
        "agent_path": { "type": "string", "minLength": 1 },
        "repository": { "type": "string", "minLength": 1 },
        "reviewed_head": { "$ref": "#/$defs/sha" },
        "snapshot": { "$ref": "#/$defs/snapshot" },
        "scope": { "type": "string", "minLength": 1 },
        "scope_sha256": { "$ref": "#/$defs/digest" },
        "required": { "const": true }
      }
    },
    "reviewCohortV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol_version", "schema_version", "cohort_id", "required_receipt",
        "reviewers", "declared_at", "cohort_sha256"
      ],
      "properties": {
        "protocol_version": { "const": "ccos-review-cohort-v1" },
        "schema_version": { "const": 1 },
        "cohort_id": { "type": "string", "minLength": 1 },
        "required_receipt": {
          "type": "object",
          "additionalProperties": false,
          "required": ["protocol_version", "schema_version"],
          "properties": {
            "protocol_version": { "const": "ccos-review-completion-v1" },
            "schema_version": { "const": 1 }
          }
        },
        "reviewers": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/reviewAssignmentV1" }
        },
        "declared_at": { "type": "string", "minLength": 1 },
        "cohort_sha256": { "$ref": "#/$defs/digest" }
      }
    },
    "reviewCohortV2": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol_version", "schema_version", "cohort_id", "required_receipt",
        "reviewers", "declared_at", "cohort_sha256"
      ],
      "properties": {
        "protocol_version": { "const": "ccos-review-cohort-v2" },
        "schema_version": { "const": 2 },
        "cohort_id": { "type": "string", "minLength": 1 },
        "required_receipt": {
          "type": "object",
          "additionalProperties": false,
          "required": ["protocol_version", "schema_version"],
          "properties": {
            "protocol_version": { "const": "ccos-review-completion-v2" },
            "schema_version": { "const": 2 }
          }
        },
        "reviewers": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/reviewAssignmentV2" }
        },
        "declared_at": { "type": "string", "minLength": 1 },
        "cohort_sha256": { "$ref": "#/$defs/digest" }
      }
    },
    "nativeReviewVerificationSubmission": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol_version", "schema_version", "status", "mode", "native_thread_id",
        "native_parent_thread_id", "agent_path", "rollout_relative_path",
        "attestation_turn_id", "started_at", "completed_at", "log_prefix_sha256",
        "last_agent_message_sha256", "evidence_sha256", "verification_sha256"
      ],
      "properties": {
        "protocol_version": { "const": "ccos-review-native-verification-v1" },
        "schema_version": { "const": 1 },
        "status": { "const": "VERIFIED" },
        "mode": { "const": "native_submission" },
        "native_thread_id": { "$ref": "#/$defs/nativeUuid7" },
        "native_parent_thread_id": { "$ref": "#/$defs/nativeUuid7" },
        "agent_path": { "type": "string", "minLength": 1 },
        "rollout_relative_path": { "type": "string", "minLength": 1 },
        "attestation_turn_id": { "$ref": "#/$defs/nativeUuid7" },
        "started_at": { "type": "string", "minLength": 1 },
        "completed_at": { "type": "string", "minLength": 1 },
        "log_prefix_sha256": { "$ref": "#/$defs/digest" },
        "last_agent_message_sha256": { "$ref": "#/$defs/digest" },
        "evidence_sha256": { "$ref": "#/$defs/digest" },
        "verification_sha256": { "$ref": "#/$defs/digest" }
      }
    },
    "nativeReviewVerificationLegacy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol_version", "schema_version", "status", "mode", "native_thread_id",
        "native_parent_thread_id", "agent_path", "rollout_relative_path",
        "attestation_turn_id", "legacy_completed_turn_id", "started_at", "completed_at",
        "log_prefix_sha256", "last_agent_message_sha256", "evidence_sha256",
        "legacy_receipt_sha256", "verification_sha256"
      ],
      "properties": {
        "protocol_version": { "const": "ccos-review-native-verification-v1" },
        "schema_version": { "const": 1 },
        "status": { "const": "VERIFIED" },
        "mode": { "const": "legacy_attestation" },
        "native_thread_id": { "$ref": "#/$defs/nativeUuid7" },
        "native_parent_thread_id": { "$ref": "#/$defs/nativeUuid7" },
        "agent_path": { "type": "string", "minLength": 1 },
        "rollout_relative_path": { "type": "string", "minLength": 1 },
        "attestation_turn_id": { "$ref": "#/$defs/nativeUuid7" },
        "legacy_completed_turn_id": { "$ref": "#/$defs/nativeUuid7" },
        "started_at": { "type": "string", "minLength": 1 },
        "completed_at": { "type": "string", "minLength": 1 },
        "log_prefix_sha256": { "$ref": "#/$defs/digest" },
        "last_agent_message_sha256": { "$ref": "#/$defs/digest" },
        "evidence_sha256": { "$ref": "#/$defs/digest" },
        "legacy_receipt_sha256": { "$ref": "#/$defs/digest" },
        "verification_sha256": { "$ref": "#/$defs/digest" }
      }
    },
    "reviewCompletionV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol_version", "schema_version", "case_id", "cohort_id", "reviewer_id",
        "reviewer_role", "thread_id", "completed_turn_id", "repository", "reviewed_head",
        "snapshot", "scope", "scope_sha256", "completion_state", "finding_ids",
        "completed_at", "native_completion_evidence_sha256", "request_id", "recorded_at",
        "receipt_sha256"
      ],
      "properties": {
        "protocol_version": { "const": "ccos-review-completion-v1" },
        "schema_version": { "const": 1 },
        "case_id": { "$ref": "#/$defs/caseId" },
        "cohort_id": { "type": "string", "minLength": 1 },
        "reviewer_id": { "type": "string", "minLength": 1 },
        "reviewer_role": { "const": "review_child" },
        "thread_id": { "type": "string", "minLength": 1 },
        "completed_turn_id": { "type": "string", "minLength": 1 },
        "repository": { "type": "string", "minLength": 1 },
        "reviewed_head": { "$ref": "#/$defs/sha" },
        "snapshot": {
          "oneOf": [
            { "$ref": "#/$defs/snapshot" },
            { "$ref": "#/$defs/legacyReviewSnapshot" }
          ]
        },
        "scope": { "type": "string", "minLength": 1 },
        "scope_sha256": { "$ref": "#/$defs/digest" },
        "completion_state": { "enum": ["COMPLETED", "FAILED", "INCOMPLETE"] },
        "finding_ids": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "completed_at": { "type": "string", "minLength": 1 },
        "native_completion_evidence_sha256": { "$ref": "#/$defs/digest" },
        "request_id": { "type": "string", "minLength": 1 },
        "recorded_at": { "type": "string", "minLength": 1 },
        "receipt_sha256": { "$ref": "#/$defs/digest" },
        "native_verification": { "$ref": "#/$defs/nativeReviewVerificationLegacy" }
      }
    },
    "reviewCompletionV2": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol_version", "schema_version", "case_id", "cohort_id", "reviewer_id",
        "reviewer_role", "thread_id", "native_thread_id", "native_parent_thread_id",
        "agent_path", "completed_turn_id", "started_at", "repository", "reviewed_head",
        "snapshot", "scope", "scope_sha256", "completion_state", "finding_ids",
        "completed_at", "native_completion_evidence_sha256", "native_verification",
        "request_id", "recorded_at", "receipt_sha256"
      ],
      "properties": {
        "protocol_version": { "const": "ccos-review-completion-v2" },
        "schema_version": { "const": 2 },
        "case_id": { "$ref": "#/$defs/caseId" },
        "cohort_id": { "type": "string", "minLength": 1 },
        "reviewer_id": { "type": "string", "minLength": 1 },
        "reviewer_role": { "const": "review_child" },
        "thread_id": { "type": "string", "minLength": 1 },
        "native_thread_id": { "$ref": "#/$defs/nativeUuid7" },
        "native_parent_thread_id": { "$ref": "#/$defs/nativeUuid7" },
        "agent_path": { "type": "string", "minLength": 1 },
        "completed_turn_id": { "$ref": "#/$defs/nativeUuid7" },
        "started_at": { "type": "string", "minLength": 1 },
        "repository": { "type": "string", "minLength": 1 },
        "reviewed_head": { "$ref": "#/$defs/sha" },
        "snapshot": { "$ref": "#/$defs/snapshot" },
        "scope": { "type": "string", "minLength": 1 },
        "scope_sha256": { "$ref": "#/$defs/digest" },
        "completion_state": { "enum": ["COMPLETED", "FAILED", "INCOMPLETE"] },
        "finding_ids": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "completed_at": { "type": "string", "minLength": 1 },
        "native_completion_evidence_sha256": { "$ref": "#/$defs/digest" },
        "native_verification": { "$ref": "#/$defs/nativeReviewVerificationSubmission" },
        "request_id": { "type": "string", "minLength": 1 },
        "recorded_at": { "type": "string", "minLength": 1 },
        "receipt_sha256": { "$ref": "#/$defs/digest" }
      }
    },
    "reviewControl": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cohort", "receipts"],
      "properties": {
        "cohort": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/reviewCohortV1" },
            { "$ref": "#/$defs/reviewCohortV2" }
          ]
        },
        "receipts": {
          "type": "object",
          "additionalProperties": {
            "oneOf": [
              { "$ref": "#/$defs/reviewCompletionV1" },
              { "$ref": "#/$defs/reviewCompletionV2" }
            ]
          }
        }
      }
    },
    "runtimeActorV2": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol_version",
        "schema_version",
        "thread_id",
        "role",
        "parent_thread_id",
        "agent_path",
        "identity_evidence_sha256",
        "binding_source",
        "bound_at",
        "actor_sha256"
      ],
      "properties": {
        "protocol_version": { "const": "ccos-runtime-actor-v2" },
        "schema_version": { "const": 2 },
        "thread_id": { "type": "string", "minLength": 1 },
        "role": {
          "enum": [
            "parent",
            "implementer_child",
            "review_child",
            "closure_child",
            "incomplete_child",
            "fix_child",
            "publication_child"
          ]
        },
        "parent_thread_id": {
          "oneOf": [
            { "type": "null" },
            { "type": "string", "minLength": 1 }
          ]
        },
        "agent_path": { "type": "string", "minLength": 1 },
        "identity_evidence_sha256": { "$ref": "#/$defs/digest" },
        "binding_source": {
          "const": "controller_verified_native_thread_read"
        },
        "bound_at": { "type": "string", "minLength": 1 },
        "actor_sha256": { "$ref": "#/$defs/digest" }
      }
    },
    "runtimeActorV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol_version",
        "schema_version",
        "thread_id",
        "role",
        "parent_thread_id",
        "agent_path",
        "identity_evidence_sha256",
        "binding_source",
        "bound_at",
        "actor_sha256"
      ],
      "properties": {
        "protocol_version": { "const": "ccos-runtime-actor-v1" },
        "schema_version": { "const": 1 },
        "thread_id": { "type": "string", "minLength": 1 },
        "role": {
          "enum": [
            "parent",
            "implementer_child",
            "review_child",
            "closure_child",
            "incomplete_child",
            "fix_child",
            "publication_child"
          ]
        },
        "parent_thread_id": {
          "oneOf": [
            { "type": "null" },
            { "type": "string", "minLength": 1 }
          ]
        },
        "agent_path": { "type": "string", "minLength": 1 },
        "identity_evidence_sha256": { "$ref": "#/$defs/digest" },
        "binding_source": { "const": "native_thread_read" },
        "bound_at": { "type": "string", "minLength": 1 },
        "actor_sha256": { "$ref": "#/$defs/digest" }
      }
    },
    "runtimeActor": {
      "oneOf": [
        { "$ref": "#/$defs/runtimeActorV1" },
        { "$ref": "#/$defs/runtimeActorV2" }
      ]
    },
    "runtimeControl": {
      "type": "object",
      "additionalProperties": false,
      "required": ["actors", "action_grants"],
      "properties": {
        "actors": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/runtimeActor" }
        },
        "action_grants": {
          "type": "object",
          "maxProperties": 1,
          "additionalProperties": { "type": "object" }
        }
      }
    },
    "antiLoopDispositionAuthority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol_version",
        "schema_version",
        "authority_id",
        "case_id",
        "decision",
        "product_heads",
        "native_thread_id",
        "native_turn_id",
        "rollout_relative_path",
        "decided_at",
        "message_sha256",
        "log_prefix_sha256",
        "evidence_sha256",
        "native_verification_protocol",
        "authority_sha256"
      ],
      "properties": {
        "protocol_version": {
          "const": "ccos-anti-loop-human-disposition-v1"
        },
        "schema_version": { "const": 2 },
        "authority_id": { "type": "string", "minLength": 1 },
        "case_id": { "$ref": "#/$defs/caseId" },
        "decision": {
          "enum": [
            "STOP_CASE",
            "SHIP_PRODUCT_WITH_CONTROL_QUARANTINED"
          ]
        },
        "product_heads": { "$ref": "#/$defs/headMap" },
        "native_thread_id": { "$ref": "#/$defs/nativeUuid7" },
        "native_turn_id": { "$ref": "#/$defs/nativeUuid7" },
        "rollout_relative_path": { "type": "string", "minLength": 1 },
        "decided_at": { "type": "string", "minLength": 1 },
        "message_sha256": { "$ref": "#/$defs/digest" },
        "log_prefix_sha256": { "$ref": "#/$defs/digest" },
        "evidence_sha256": { "$ref": "#/$defs/digest" },
        "native_verification_protocol": {
          "const": "ccos-anti-loop-native-human-verification-v1"
        },
        "authority_sha256": { "$ref": "#/$defs/digest" }
      }
    },
    "antiLoopLatch": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol_version",
        "schema_version",
        "status",
        "objective_sha256",
        "product_heads",
        "consecutive_support_mutations",
        "last_support_action",
        "last_failure_fingerprint",
        "failure_fingerprint_repetitions",
        "event_count",
        "trigger_reason",
        "trigger_event_id",
        "latched_at",
        "latched_from_state",
        "disposition",
        "disposition_authority",
        "record_sha256"
      ],
      "properties": {
        "protocol_version": { "const": "ccos-anti-loop-latch-v1" },
        "schema_version": { "const": 1 },
        "status": { "enum": ["CLEAR", "LATCHED", "DISPOSED"] },
        "objective_sha256": { "$ref": "#/$defs/digest" },
        "product_heads": { "$ref": "#/$defs/headMap" },
        "consecutive_support_mutations": {
          "type": "integer",
          "minimum": 0
        },
        "last_support_action": { "type": ["string", "null"] },
        "last_failure_fingerprint": { "type": ["string", "null"] },
        "failure_fingerprint_repetitions": {
          "type": "integer",
          "minimum": 0
        },
        "event_count": { "type": "integer", "minimum": 0 },
        "trigger_reason": { "type": ["string", "null"] },
        "trigger_event_id": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/requestId" }
          ]
        },
        "latched_at": { "type": ["string", "null"] },
        "latched_from_state": { "type": ["string", "null"] },
        "disposition": {
          "enum": [
            null,
            "STOP_CASE",
            "SHIP_PRODUCT_WITH_CONTROL_QUARANTINED"
          ]
        },
        "disposition_authority": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/antiLoopDispositionAuthority" }
          ]
        },
        "record_sha256": { "$ref": "#/$defs/digest" }
      }
    },
    "terminalQuarantine": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "required": [
            "protocol_version",
            "schema_version",
            "request_id",
            "prior_state",
            "prior_revision",
            "prior_record_sha256",
            "backup_path",
            "backup_sha256",
            "record_sha256"
          ],
          "properties": {
            "protocol_version": { "const": "ccos-terminal-quarantine-v1" },
            "schema_version": { "const": 1 },
            "request_id": { "type": "string", "minLength": 1 },
            "prior_state": { "const": "CLOSED_SUCCESS" },
            "prior_revision": { "type": "integer", "minimum": 1 },
            "prior_record_sha256": { "$ref": "#/$defs/digest" },
            "backup_path": { "type": "string", "minLength": 1 },
            "backup_sha256": { "$ref": "#/$defs/digest" },
            "record_sha256": { "$ref": "#/$defs/digest" }
          }
        }
      ]
    },
    "runtimeGenerationAbort": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "protocol_version",
            "schema_version",
            "grant_id",
            "snapshot_event_sha256",
            "lockdown_intent_event_sha256",
            "acl_restored_event_sha256",
            "reason_code",
            "aborted_at",
            "record_sha256"
          ],
          "properties": {
            "protocol_version": { "const": "ccos-preissue-generation-abort-v1" },
            "schema_version": { "const": 1 },
            "grant_id": { "type": "string", "minLength": 1 },
            "snapshot_event_sha256": { "$ref": "#/$defs/digest" },
            "lockdown_intent_event_sha256": { "$ref": "#/$defs/digest" },
            "acl_restored_event_sha256": { "$ref": "#/$defs/digest" },
            "reason_code": { "const": "PREISSUE_GENERATION_ABANDONED" },
            "aborted_at": { "type": "string", "minLength": 1 },
            "record_sha256": { "$ref": "#/$defs/digest" }
          }
        }
      ]
    },
    "runtimeGenerationAttempt": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "protocol_version",
            "schema_version",
            "attempt_id",
            "grant_id",
            "controller_spec_sha256",
            "status",
            "claimed_at",
            "finalized_at",
            "abort_reason_code",
            "record_sha256"
          ],
          "properties": {
            "protocol_version": { "const": "ccos-runtime-generation-attempt-v1" },
            "schema_version": { "const": 1 },
            "attempt_id": { "type": "string", "minLength": 1 },
            "grant_id": { "type": "string", "minLength": 1 },
            "controller_spec_sha256": { "$ref": "#/$defs/digest" },
            "status": { "enum": ["CLAIMED", "GRANT_ISSUED", "ABORTED"] },
            "claimed_at": { "type": "string", "minLength": 1 },
            "finalized_at": { "type": ["string", "null"] },
            "abort_reason_code": {
              "enum": [null, "CONTROLLER_GENERATION_ABANDONED"]
            },
            "record_sha256": { "$ref": "#/$defs/digest" }
          }
        }
      ]
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "case_id",
        "revision",
        "state",
        "resumable_state",
        "objective",
        "created_at",
        "updated_at",
        "bindings",
        "limits",
        "candidate",
        "findings",
        "repair",
        "closure",
        "control",
        "lock_reason",
        "events"
      ],
      "properties": {
        "schema_version": { "const": 2 },
        "case_id": { "$ref": "#/$defs/caseId" },
        "revision": { "type": "integer", "minimum": 1 },
        "state": {
          "enum": [
            "REGISTERED",
            "IMPLEMENTING",
            "CANDIDATE_FROZEN",
            "REVIEW_COLLECTING",
            "FINDINGS_FROZEN",
            "REPAIR_AUTHORIZED",
            "REPAIR_COMPLETE",
            "CLOSURE_PREFLIGHT",
            "CLOSURE_CHECK",
            "CLOSED_SUCCESS",
            "CASE_LOCKED",
            "ANTI_LOOP_LOCKED",
            "CONTROL_FAILURE"
          ]
        },
        "resumable_state": { "type": ["string", "null"] },
        "objective": { "type": "string", "minLength": 1 },
        "created_at": { "type": "string" },
        "updated_at": { "type": "string" },
        "bindings": { "$ref": "#/$defs/caseBindings" },
        "limits": { "$ref": "#/$defs/limits" },
        "candidate": { "$ref": "#/$defs/candidate" },
        "review": { "$ref": "#/$defs/reviewControl" },
        "findings": { "type": "object" },
        "repair": { "type": "object" },
        "closure": { "type": "object" },
        "control": { "type": "object" },
        "anti_loop_latch": { "$ref": "#/$defs/antiLoopLatch" },
        "runtime": { "$ref": "#/$defs/runtimeControl" },
        "runtime_generation_attempt": { "$ref": "#/$defs/runtimeGenerationAttempt" },
        "terminal_quarantine": { "$ref": "#/$defs/terminalQuarantine" },
        "runtime_generation_abort": { "$ref": "#/$defs/runtimeGenerationAbort" },
        "lock_reason": { "type": ["string", "null"] },
        "events": { "type": "object" }
      }
    }
  }
}
